{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "permission": {
    "external_directory": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow"
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/backups/**",
      "**/build/**",
      "**/.dart_tool/**",
      "**/dist/**",
      "**/.next/**",
      "**/coverage/**",
      "**/*.log",
      "**/pubspec.lock"
    ]
  }
}
