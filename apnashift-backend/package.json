{
  "name": "apnashift-backend",
  "version": "0.1.0",
  "description": "ApnaShift MVP backend: on-demand shifting (pickup, mini truck, mini tractor) for one city",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:mssql": "node scripts/migrate-mssql.js",
    "tracking:prune": "node scripts/prune-locations.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.3"
  }
}
