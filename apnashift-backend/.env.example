# ApnaShift backend config. Copy to .env (never commit .env).
# .env.example ke saath synced rakho — naya secret aaye to dono me jodo.

# Server
PORT=3000
NODE_ENV=development

# Postgres connection string (password isi me hai — kahin log/share mat karo)
DATABASE_URL=postgres://apnashift:changeme@localhost:5432/apnashift

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS: frontend ka origin (comma-separated allowed). Dev me * chalega.
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Login/register par sakht limit (brute-force rokne ke liye)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Estimate-price (public) par limit — DB + provider cost bachane ke liye
ESTIMATE_RATE_LIMIT_WINDOW_MS=900000
ESTIMATE_RATE_LIMIT_MAX=60
# Booking create / rating (login wale write endpoints) par limit
WRITE_RATE_LIMIT_WINDOW_MS=900000
WRITE_RATE_LIMIT_MAX=60
# Proxy ke peeche ho (Render/Heroku/Nginx) to TRUST_PROXY=1, nahi to khaali.
# Galat set karne se rate limit bypass ho sakta hai — docs/API.md dekho.
TRUST_PROXY=

# Commission due cap (Rs) — driver accept gate. Baaki zyada ho to 403.
COMMISSION_DUE_LIMIT=1500

# MS SQL Server (local SSMS instance; PostgreSQL stays the live DB).
# Credentials ONLY here in .env (never commit, never frontend).
# SSMS "Server name" me yahi dalo: LAPTOP-0KTPRBS3\SQLEXPRESS01
MSSQL_SERVER=localhost
MSSQL_INSTANCE=SQLEXPRESS01
MSSQL_PORT=14330
MSSQL_DATABASE=ApnaShift
MSSQL_USER=apnashift_app
MSSQL_PASSWORD=change-me-to-the-sql-login-password
MSSQL_ENCRYPT=false

# Live tracking (driver GPS): dedicated limiter + staleness + retention.
TRACK_RATE_LIMIT_WINDOW_MS=60000
TRACK_RATE_LIMIT_MAX=60
TRACK_MIN_INTERVAL_MS=3000
TRACK_STALE_AFTER_MS=60000
TRACK_OFFLINE_AFTER_MS=180000
TRACK_RETENTION_DAYS=30

# Distance provider: haversine (free, default) ya google
DISTANCE_PROVIDER=haversine
# Google Distance Matrix key — sirf DISTANCE_PROVIDER=google par chahiye.
# Bina key ke google provider error dega. Key kabhi log/share mat karo.
GOOGLE_MAPS_KEY=
# Geoapify key (maps tiles + geocode autocomplete + routing proxy).
# Asli key sirf .env me rakho, yahan khaali rakho. Key bina geo endpoints
# 503 dete hain aur tracking map OSM fallback par chalta hai.
GEOAPIFY_API_KEY=

# Password-reset OTP (zero-cost dev mode).
# OTP generate FREE hai; SMS bhejna paid (~Rs 0.13-0.25/OTP) — provider
# lagne tak OTP console me log hota hai (Rs 0). Production me debug OTP kabhi nahi.
# OTP_DEV_RETURN=1 (dev/test) -> /forgot-password response me debug_otp milta hai.
OTP_DEV_RETURN=
# Future SMS provider (optional): lagao tabhi SMS jayega, nahi to console fallback.
OTP_SMS_URL=
OTP_SMS_KEY=
# MSG91 (recommended, Flow API): OTP hum banate hain, MSG91 sirf DLT-approved
# template se SMS pahunchata hai. Verify logic backend me hi rehta hai.
# Flow panel me template me OTP variable + valid DLT zaroori (warna reject).
OTP_SMS_PROVIDER=
OTP_MSG91_AUTHKEY=
OTP_MSG91_FLOW_ID=
OTP_MSG91_SENDER=
# Template me OTP variable ka naam (default OTP, jaise ##OTP## -> OTP).
OTP_MSG91_OTP_VAR=
# OTP hash pepper (optional) — khaali ho to JWT_SECRET use hota hai.
OTP_PEPPER=
