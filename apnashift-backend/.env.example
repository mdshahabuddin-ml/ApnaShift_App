# ApnaShift backend config. Copy to .env (never commit .env).
# .env.example ke saath synced rakho — naya secret aaye to dono me jodo.

# Server
PORT=3000
NODE_ENV=development

# Postgres connection string (password isi me hai — kahin log/share mat karo)
DATABASE_URL=postgres://apnashift:changeme@localhost:5432/apnashift

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS: frontend ka origin (comma-separated allowed). Dev me * chalega.
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Login/register par sakht limit (brute-force rokne ke liye)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Estimate-price (public) par limit — DB + provider cost bachane ke liye
ESTIMATE_RATE_LIMIT_WINDOW_MS=900000
ESTIMATE_RATE_LIMIT_MAX=60
# Booking create / rating (login wale write endpoints) par limit
WRITE_RATE_LIMIT_WINDOW_MS=900000
WRITE_RATE_LIMIT_MAX=60
# Proxy ke peeche ho (Render/Heroku/Nginx) to TRUST_PROXY=1, nahi to khaali.
# Galat set karne se rate limit bypass ho sakta hai — docs/API.md dekho.
TRUST_PROXY=

# Distance provider: haversine (free, default) ya google
DISTANCE_PROVIDER=haversine
# Google Distance Matrix key — sirf DISTANCE_PROVIDER=google par chahiye.
# Bina key ke google provider error dega. Key kabhi log/share mat karo.
GOOGLE_MAPS_KEY=
